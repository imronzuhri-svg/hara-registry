# HaraLedger chain — local dev environment
# Copy to .env and adjust as needed

# QBFT
HARA_CHAIN_ID=131216
HARA_BLOCK_PERIOD_SECONDS=2
HARA_EPOCH_LENGTH=30000
HARA_VALIDATOR_COUNT=4

# Vault (dev mode — never use these values outside local dev)
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN=haraledger-dev-root

# Postgres
POSTGRES_USER=hara
POSTGRES_PASSWORD=hara_dev_password
POSTGRES_DB=hara_indexer

# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin

# Besu image
BESU_IMAGE=hyperledger/besu:26.4.0
