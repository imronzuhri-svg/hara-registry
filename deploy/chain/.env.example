# hara-registry-chain — production environment template

# Vault for key fetch (must match platform/.env)
VAULT_DEV_ROOT_TOKEN=must-match-platform-env

# Optional: validator on this host (only for validator-only.yml)
# VALIDATOR_ID=1

# Optional tuning
HARA_CHAIN_ID=131216
HARA_BLOCK_PERIOD_SECONDS=2
HARA_VALIDATOR_COUNT=4

# P2P port binding — usually exposed to other validators only via WireGuard
V1_P2P_BIND=0.0.0.0:30303
