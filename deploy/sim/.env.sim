# deploy/sim/.env.sim — LOCAL SIMULATION ENV
# Values here are DEV-ONLY, hardcoded. Do NOT use these in production.
# Real prod values come from deploy/ops/secrets-bootstrap.sh on the VPS.
#
# This file is the single env-file for the entire 6-node local simulation:
#   • hara-stateful  → vault (dev mode from _platform), postgres, redis, minio
#   • hara-stateless → migrate, signer, broadcaster, indexer, rpc-cache,
#                      anchor-worker, blockscout(+fe), HAProxy LB, observability
#   • hara-v1..v4    → 4 Besu QBFT validators
#
# Caddy is NOT included in the sim (no TLS — services exposed directly on
# localhost). Backup scripts are NOT cron'd locally. Both are prod-only.

# ── Vault (dev mode, from _platform) ────────────────────────────────────────
VAULT_DEV_ROOT_TOKEN=haraledger-dev-root
VAULT_BIND=127.0.0.1:8200
VAULT_CLUSTER_BIND=127.0.0.1:8201

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=hara
POSTGRES_PASSWORD=harapassword-sim
POSTGRES_DB=hara_indexer
POSTGRES_BIND=127.0.0.1:5432

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_BIND=127.0.0.1:6379
REDIS_MAXMEMORY=512mb

# ── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=haraadmin
MINIO_ROOT_PASSWORD=haraminio-sim
MINIO_API_BIND=127.0.0.1:9000
MINIO_CONSOLE_BIND=127.0.0.1:9001

# ── Chain ───────────────────────────────────────────────────────────────────
HARA_CHAIN_ID=131216
HARA_BLOCK_PERIOD_SECONDS=2
HARA_VALIDATOR_COUNT=4
V1_P2P_BIND=0.0.0.0:30303

# ── RPC tier (the LB on hara-stateless) ─────────────────────────────────────
RPC_HTTP_BIND=0.0.0.0:8545
RPC_WS_BIND=0.0.0.0:8546
HAPROXY_STATS_BIND=127.0.0.1:8404

# ── Services ────────────────────────────────────────────────────────────────
SIGNER_BIND=127.0.0.1:7000
INDEXER_METRICS_BIND=127.0.0.1:9100
RPC_CACHE_BIND=0.0.0.0:8088
ANCHOR_METRICS_BIND=127.0.0.1:9102
BLOCKSCOUT_BE_BIND=127.0.0.1:4000
BLOCKSCOUT_FE_BIND=0.0.0.0:4010

# ── Observability (from _platform) ──────────────────────────────────────────
GRAFANA_BIND=0.0.0.0:3200
GF_SECURITY_ADMIN_PASSWORD=admin
GF_SERVER_ROOT_URL=http://localhost:3200
PROM_BIND=127.0.0.1:9090
ALERTMANAGER_BIND=127.0.0.1:9093
LOKI_BIND=127.0.0.1:3201
TEMPO_OTLP_HTTP_BIND=127.0.0.1:4318
PROM_RETENTION=14d

# ── Image source ────────────────────────────────────────────────────────────
# Empty → docker compose build hara-ledger-* images locally from source.
# Set to "ghcr.io/imronzuhri-svg/" to pull production images instead.
IMAGE_REGISTRY=
IMAGE_TAG=latest

# ── Anchor worker ───────────────────────────────────────────────────────────
# Contract address gets filled in by sim-up.sh AFTER `make deploy-all` runs.
# Until then, anchor-worker is not started.
PQ_ANCHOR_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
ANCHOR_INTERVAL_MS=600000

# ── Backups (sim only, NOT exercised — sentinel value so compose validates) ─
BACKUP_AGE_RECIPIENT=age1simulationsentinel0000000000000000000000000000000000000
