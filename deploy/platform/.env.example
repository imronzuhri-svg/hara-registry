# hara-platform — production environment template
# Copy to .env and replace ALL placeholders with real values.
# Real values should come from ops/secrets-bootstrap.sh which generates them
# and pushes the originals to Vault.

# ─────────────────────────────────────────────────────────────────────────
# Required secrets — must be replaced in production
# ─────────────────────────────────────────────────────────────────────────

# Vault dev root token (Phase-1 only — replace Vault with HA Raft mode at P1b
# and use AppRole auth, not a root token)
VAULT_DEV_ROOT_TOKEN=CHANGE-ME-32-byte-random

# Grafana admin password
GF_SECURITY_ADMIN_PASSWORD=CHANGE-ME-32-byte-random

# ─────────────────────────────────────────────────────────────────────────
# Network binding — for production, lock most services to 127.0.0.1 and
# only expose what's user-facing via the LB or a reverse proxy.
# ─────────────────────────────────────────────────────────────────────────

GRAFANA_BIND=0.0.0.0:3200          # User-facing (put a TLS proxy in front)
VAULT_BIND=127.0.0.1:8200          # Internal only (ssh tunnel for ops)
PROM_BIND=127.0.0.1:9090           # Internal only
ALERTMANAGER_BIND=127.0.0.1:9093   # Internal only
LOKI_BIND=127.0.0.1:3201           # Internal only

# ─────────────────────────────────────────────────────────────────────────
# Optional tuning
# ─────────────────────────────────────────────────────────────────────────
PROM_RETENTION=90d                  # Metric retention. 30d for tight budgets.
GF_SERVER_ROOT_URL=http://localhost:3200  # Set to https://grafana.hara.example.com in prod
