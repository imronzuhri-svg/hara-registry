# hara-ledger-services env

# Inherited from data/.env (must match)
POSTGRES_USER=hara
POSTGRES_PASSWORD=must-match-data-env
POSTGRES_DB=hara_indexer

# Inherited from platform/.env (must match)
VAULT_DEV_ROOT_TOKEN=must-match-platform-env

HARA_CHAIN_ID=131216

# Bindings
SIGNER_BIND=127.0.0.1:7000          # Internal only — protect with API key auth at the LB
INDEXER_METRICS_BIND=127.0.0.1:9100  # Internal only
RPC_CACHE_BIND=0.0.0.0:8088          # User-facing (or internal-only depending on use)
BLOCKSCOUT_BE_BIND=127.0.0.1:4000   # Internal only — proxy through fe
BLOCKSCOUT_FE_BIND=0.0.0.0:4010      # User-facing (TLS via Caddy)
