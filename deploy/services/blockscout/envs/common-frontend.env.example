# Blockscout frontend (Next.js) — PRODUCTION template.
#
# Copy to common-frontend.env (gitignored) on hara-stateless-2 and keep current.
#
# CRITICAL: every NEXT_PUBLIC_* value here is consumed by the BROWSER, so the API
# host MUST be the PUBLIC origin — never `localhost`. Caddy (deploy/edge/Caddyfile)
# serves explorer.ledger.haratrust.io and routes /api/* + /socket/* to the
# backend (hara-blockscout:4000); everything else goes to this frontend. Pointing
# these at localhost makes every remote visitor's browser call its OWN machine,
# so all /api/v2/* calls fail and the UI sits on "Loading data…" skeletons.
#
# (Local-dev values — localhost:4000 / http / ws — live in chain/blockscout/envs/.)

# Where the browser reaches the backend (via Caddy → hara-blockscout:4000)
NEXT_PUBLIC_API_HOST=explorer.ledger.haratrust.io
NEXT_PUBLIC_API_PORT=443
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss

# The frontend's own public origin (absolute URLs / social meta)
NEXT_PUBLIC_APP_HOST=explorer.ledger.haratrust.io
NEXT_PUBLIC_APP_PORT=443
NEXT_PUBLIC_APP_PROTOCOL=https

# Network identity displayed in the UI
NEXT_PUBLIC_NETWORK_NAME=Hara Registry
NEXT_PUBLIC_NETWORK_SHORT_NAME=Hara
NEXT_PUBLIC_NETWORK_ID=131216
NEXT_PUBLIC_NETWORK_RPC_URL=https://rpc.ledger.haratrust.io/read/
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=HARA
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=HARA
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE=validation

# Feature toggles
NEXT_PUBLIC_IS_TESTNET=true
NEXT_PUBLIC_GAS_TRACKER_ENABLED=false
NEXT_PUBLIC_HAS_BEACON_CHAIN=false
NEXT_PUBLIC_HAS_USER_OPS=false
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
NEXT_PUBLIC_VISUALIZE_API_HOST=
NEXT_PUBLIC_STATS_API_HOST=

# (No rollup — leave NEXT_PUBLIC_ROLLUP_TYPE unset entirely)
