# Strata Console — environment

# Dev: the Vite dev server proxies /rpc -> this upstream (avoids CORS).
VITE_RPC_UPSTREAM=https://rpc.ledger.haratrust.io

# Where the SPA POSTs read-only JSON-RPC. Default is the dev-proxied path.
# In production, point at the Console API's read route on the same origin.
VITE_RPC_READ_URL=/rpc/read/
