# Strata Console (web) — environment

# Dev: the Vite dev server proxies /api -> the Console API.
# Run the API with: pnpm --dir server start   (defaults to http://localhost:8910)
VITE_API_UPSTREAM=http://localhost:8910

# Where the SPA fetches the aggregated overview. Default works for dev + prod
# (same-origin in production).
VITE_API_BASE=/api
