# ── HARA Gapura Gateway — environment ────────────────────────────────────────
# Copy to .env and fill in. Secrets (ANCHOR_ECDSA_KEY, PQ_MLDSA_SEED) come from
# Vault at deploy time — NEVER commit real key material.

# HTTP
GATEWAY_PORT=8930

# ── Auth (Authentik OAuth2 client-credentials, ADR-0018) ─────────────────────
# When these are UNSET the Gateway runs in DEV-BYPASS auth mode (see src/auth.ts):
# every request is treated as an authenticated `dev` tenant with all scopes.
# That bypass is for local dev only — set all three in staging/prod.
AUTHENTIK_JWKS_URL=
AUTHENTIK_ISSUER=
AUTHENTIK_AUDIENCE=

# ── Chain (HARA Registry, QBFT Besu, chain 131216, gasPrice 0, legacy txs) ───
RPC_WRITE_URL=https://rpc.ledger.haratrust.io/write/
RPC_READ_URL=https://rpc.ledger.haratrust.io/read/
CHAIN_ID=131216
PQ_ANCHOR_REGISTRY=0x8A791620dd6260079BF849Dc5567aDC3F2FdC318

# Explicit gas limit for recordAnchor (chain is gasPrice 0, so this is a cap
# not a fee). Tune to the contract's actual cost.
ANCHOR_GAS_LIMIT=500000

# PQ algorithm label committed alongside the anchor (FIPS 204).
PQ_ALGORITHM=ML-DSA-65

# ── Secrets (from Vault — placeholders here) ─────────────────────────────────
# ANCHOR_ECDSA_KEY: 0x-prefixed 32-byte private key that HOLDS ANCHOR_ROLE on
#   PQAnchorRegistry and is pre-funded (Besu drops zero-balance senders even at
#   gasPrice 0). While it stays the placeholder below, POST /v1/anchors returns
#   502 anchor_failed (writes disabled); reads/verify still work.
ANCHOR_ECDSA_KEY=__from_vault__
# PQ_MLDSA_SEED: 0x-prefixed 32-byte seed → ml_dsa65.keygen(seed). Its
#   keccak256(pubkey) is the currentPQKeyHash. See README "PQ identity" for the
#   open decision about sharing the platform PQ key vs a Gapura-scoped registry.
PQ_MLDSA_SEED=__from_vault__

# ── Metadata / idempotency store ─────────────────────────────────────────────
# Empty => in-memory store (default; works out of the box, non-persistent).
# Set to a Postgres URL to use the pg-backed store (skeleton — see store/postgres.ts).
PG_URL=

# ── HaraDID resolver/registry ────────────────────────────────────────────────
# Empty => identity routes return a clearly-marked STUB DID document so the
# routes work in dev without a live resolver.
HARADID_RESOLVER_URL=
