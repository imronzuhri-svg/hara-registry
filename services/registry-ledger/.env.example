# ── HARA Registry Ledger — environment ───────────────────────────────────────
# Copy to .env and fill in. Secrets (ANCHOR_ECDSA_KEY, PQ_MLDSA_SEED) come from
# Vault at deploy time — NEVER commit real key material.

# HTTP
GATEWAY_PORT=8940

# ── Auth (Numira JWT, tenant-DID scoped) ─────────────────────────────────────
# When NUMIRA_JWKS_URL + NUMIRA_ISSUER are UNSET the Ledger runs in DEV-BYPASS
# auth mode (see src/auth.ts): every write request is treated as tenant
# `did:hara:tenant:dev`. That bypass is for local dev only — set them in prod.
# Proof/status reads are ALWAYS public (no token).
NUMIRA_JWKS_URL=
NUMIRA_ISSUER=
# Guide §2: the Ledger validates the token audience below.
NUMIRA_AUDIENCE=attest.ledger.haratrust.io

# ── Chain (HARA Registry, QBFT Besu, chain 131216, gasPrice 0, legacy txs) ───
RPC_WRITE_URL=https://rpc.ledger.haratrust.io/write/
RPC_READ_URL=https://rpc.ledger.haratrust.io/read/
CHAIN_ID=131216
# The LEDGER-SCOPED PQAnchorRegistry instance (deploy model c — separate anchor
# id-space from the platform / Gapura / Atlas). MUST NOT be the shared platform
# registry 0x8A791620...C318 — anchoring there couples the Ledger to the
# platform's PQ identity. On-chain anchoring stays DISABLED until this is set to
# a real Ledger-scoped instance (defaults to the zero address = unconfigured).
PQ_ANCHOR_REGISTRY=

# Explicit gas cap for recordAnchor (chain is gasPrice 0, so this is a cap not a fee).
ANCHOR_GAS_LIMIT=500000

# PQ algorithm label committed alongside the anchor (FIPS 204).
PQ_ALGORITHM=ML-DSA-65

# ── Secrets (from Vault — placeholders here) ─────────────────────────────────
# ANCHOR_ECDSA_KEY: 0x + 64 hex private key that HOLDS ANCHOR_ROLE on the
#   Ledger-scoped PQAnchorRegistry and is pre-funded (Besu drops zero-balance
#   senders even at gasPrice 0). While it stays a placeholder, STHs are returned
#   locally-signed but UNANCHORED (no on-chain anchor); the transparency-log
#   features (append, inclusion, consistency) still work.
ANCHOR_ECDSA_KEY=__from_vault__
# PQ_MLDSA_SEED: 0x + 64 hex (32-byte) seed → ml_dsa65.keygen(seed). Its
#   keccak256(pubkey) is the instance's currentPQKeyHash. Signs each STH.
PQ_MLDSA_SEED=__from_vault__

# ── Metadata store ───────────────────────────────────────────────────────────
# Empty => in-memory store (default; works out of the box, non-persistent).
# Set to a Postgres URL to use the pg-backed store (skeleton — see store/postgres.ts).
PG_URL=
